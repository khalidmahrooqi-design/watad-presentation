{
  "name": "watad-presentation",
  "version": "1.1.3",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check src scripts tests *.ts *.json",
    "build": "vite build && vite build --ssr src/render.tsx --outDir .ssr && node scripts/prerender.mjs && node scripts/validate.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "test": "node --test tests/navigation.test.mjs",
    "test:e2e": "playwright test",
    "assets": "node scripts/create-assets.mjs",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.19.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "@zxing/library": "^0.23.0",
    "prettier": "^3.9.9",
    "qrcode": "1.5.4",
    "sharp": "0.35.5",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "wawoff2": "^2.0.1"
  }
}
